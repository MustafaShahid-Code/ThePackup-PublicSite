# ---- Build time (used by Vite) ----
# URL that receives enquiry form submissions (JSON POST). Leave empty for demo mode.
VITE_FORM_ENDPOINT=

# ---- Server (runtime) ----
NODE_ENV=production
PORT=3000
# Absolute path OUTSIDE the app folder so content + uploads survive redeploys, e.g. /home/youruser/pack-up-data
DATA_DIR=
# Used only on the very first start to create the admin account (min 10 chars). Remove afterwards.
ADMIN_EMAIL=abc@abc.com
ADMIN_PASSWORD=abc@123
# Optional: fixed secret for session cookies (otherwise generated and stored in DATA_DIR)
SESSION_SECRET=
